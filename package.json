{
  "name": "hangar",
  "version": "1.0.0",
  "description": "Code agent workspace — single-command Pi harness manager",
  "type": "module",
  "bin": {
    "hangar": "./cli.js"
  },
  "files": [
    "cli.js",
    "backend/",
    "frontend/dist/"
  ],
  "scripts": {
    "start": "node start.js",
    "start:public": "node start.js --tunnel",
    "dev": "node start.js --dev",
    "build": "cd frontend && npm run build",
    "setup": "npm install && npm install --prefix backend && npm install --prefix frontend && npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cloudflared": "^0.7.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
